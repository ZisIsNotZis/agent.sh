    12	    if (!(b in seen)) { seen[b] = 1; nodes[++n] = b }
    13	    key = a SUBSEP b
    14	    if (!(key in edge)) {          # ignore repeated pairs
    15	        edge[key] = 1
    16	        adj[b, ++adjcnt[b]] = a    # b must come before a
